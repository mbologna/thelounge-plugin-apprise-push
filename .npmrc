# Resolve only releases published at least 7 days ago (npm >= 11.10), so
# a fresh npm install never resolves a release, transitive ones included,
# younger than that; npm ci installs the lock as is. Renovate's lock file
# maintenance already resolves with --before from the preset's 7-day
# minimumReleaseAge, and skips --before when this file sets
# min-release-age, so both use the same 7-day cutoff.
min-release-age=7
